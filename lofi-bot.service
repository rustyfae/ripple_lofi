# lofi-bot.service
# Systemd service to auto-start the bot on Raspberry Pi boot.
#
# SETUP INSTRUCTIONS (on your Raspberry Pi):
# 1. Edit the paths below to match your setup
# 2. Copy this file: sudo cp lofi-bot.service /etc/systemd/system/
# 3. Reload: sudo systemctl daemon-reload
# 4. Enable: sudo systemctl enable lofi-bot
# 5. Start:  sudo systemctl start lofi-bot
# 6. Logs:   sudo journalctl -u lofi-bot -f

[Unit]
Description=Lofi 24/7 Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi                                    # change to your Pi username
WorkingDirectory=/home/pi/lofi-bot         # change to your bot folder path
ExecStart=/home/pi/lofi-bot/venv/bin/python bot.py
Restart=always
RestartSec=10                              # wait 10s before restarting on crash
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
